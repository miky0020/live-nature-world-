{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug LiveNature (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\bin\\LiveNature.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\bin",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\Program Files\\CodeBlocks\\MinGW\\bin\\gdb.exe",
            "preLaunchTask": "Build LiveNature (build.bat)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFormatters": true
                }
            ]
        }
    ]
}
